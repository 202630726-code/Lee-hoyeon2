<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>3D 웹 FPS 시뮬레이터</title>
    <!-- Three.js 3D 라이브러리 CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
        }
        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #000;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        #game-canvas {
            width: 100vw;
            height: 100vh;
            display: block;
        }

        /* 크로스헤어 (조준점) */
        #crosshair {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 10px;
            height: 10px;
            pointer-events: none;
            z-index: 10;
        }
        #crosshair::before, #crosshair::after {
            content: '';
            position: absolute;
            background: rgba(0, 255, 204, 0.8);
            box-shadow: 0 0 5px #00ffcc;
        }
        #crosshair::before {
            top: 4px; left: -10px; width: 30px; height: 2px;
        }
        #crosshair::after {
            top: -10px; left: 4px; width: 2px; height: 30px;
        }

        /* HUD (정보 창) */
        #hud {
            position: absolute;
            top: 25px;
            left: 25px;
            color: #00ffcc;
            font-size: 20px;
            font-weight: bold;
            font-family: monospace;
            text-shadow: 0 0 8px rgba(0, 255, 204, 0.8);
            pointer-events: none;
            z-index: 10;
        }
        #hud div {
            margin-bottom: 8px;
        }

        /* 시작 및 정지 오버레이 */
        #overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(10, 15, 25, 0.85);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: #fff;
            z-index: 20;
            backdrop-filter: blur(5px);
        }
        #overlay h1 {
            font-size: 48px;
            color: #00ffcc;
            text-shadow: 0 0 15px #00ffcc;
            margin-bottom: 20px;
        }
        #overlay p {
            font-size: 16px;
            line-height: 1.8;
            margin-bottom: 30px;
            text-align: center;
            color: #ccc;
        }
        #start-btn {
            padding: 15px 40px;
            font-size: 22px;
            font-weight: bold;
            background: #00ffcc;
            color: #000;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            box-shadow: 0 0 20px #00ffcc;
            transition: all 0.2s ease;
        }
        #start-btn:hover {
            background: #ffffff;
            box-shadow: 0 0 30px #ffffff;
            transform: scale(1.05);
        }
    </style>
</head>
<body>

    <div id="crosshair"></div>
    
    <div id="hud">
        <div>SCORE: <span id="score-val">0</span></div>
        <div>HEALTH: <span id="hp-val">100</span>%</div>
        <div>TARGETS: <span id="target-count">0</span></div>
    </div>

    <div id="overlay">
        <h1 id="title-text">3D FPS ARENA</h1>
        <p id="desc-text">
            <b>[조작 방법]</b><br>
            • <b>W, A, S, D</b> : 이동<br>
            • <b>마우스 이동</b> : 시점 회전 (Aim)<br>
            • <b>마우스 좌클릭</b> : 사격 (Shoot)<br>
            • <b>Esc</b> : 일시정지
        </p>
        <button id="start-btn">게임 시작 (Click to Play)</button>
    </div>

    <script>
        // --- 1. 게임 기본 및 오디오 설정 ---
        let scene, camera, renderer;
        let pitch = 0, yaw = 0;
        let moveForward = false, moveBackward = false, moveLeft = false, moveRight = false;
        let isPlaying = false;
        let score = 0, hp = 100;

        const targets = [];
        const particles = [];

        // Web Audio API Synth (사운드 효과)
        let audioCtx;
        function initAudio() {
            if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        }

        // 발사음 합성
        function playGunshotSound() {
            if (!audioCtx) return;
            const bufferSize = audioCtx.sampleRate * 0.12;
            const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
            const data = buffer.getChannelData(0);
            for (let i = 0; i < bufferSize; i++) {
                data[i] = Math.random() * 2 - 1;
            }
            const noise = audioCtx.createBufferSource();
            noise.buffer = buffer;

            const gain = audioCtx.createGain();
            gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.12);

            noise.connect(gain);
            gain.connect(audioCtx.destination);
            noise.start();
        }

        // 타격음 합성
        function playHitSound() {
            if (!audioCtx) return;
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(300, audioCtx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(800, audioCtx.currentTime + 0.08);

            gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.08);

            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start();
            osc.stop(audioCtx.currentTime + 0.08);
        }

        // --- 2. 3D 씬 초기화 ---
        function initScene() {
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x0a0f19);
            scene.fog = new THREE.FogExp2(0x0a0f19, 0.015);

            camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.set(0, 1.6, 0); // 플레이어 눈높이

            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.shadowMap.enabled = true;
            document.body.appendChild(renderer.domElement);

            // 조명
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.4);
            scene.add(ambientLight);

            const dirLight = new THREE.DirectionalLight(0x00ffcc, 0.8);
            dirLight.position.set(20, 40, 20);
            dirLight.castShadow = true;
            scene.add(dirLight);

            // 격자 무늬 바닥 생성 (Canvas 텍스처)
            const floorCanvas = document.createElement('canvas');
            floorCanvas.width = 128; floorCanvas.height = 128;
            const ctx = floorCanvas.getContext('2d');
            ctx.fillStyle = '#111827'; ctx.fillRect(0,0,128,128);
            ctx.strokeStyle = '#00ffcc'; ctx.lineWidth = 2; ctx.strokeRect(0,0,128,128);
            
            const floorTexture = new THREE.CanvasTexture(floorCanvas);
            floorTexture.wrapS = THREE.RepeatWrapping;
            floorTexture.wrapT = THREE.RepeatWrapping;
            floorTexture.repeat.set(30, 30);

            const floorGeo = new THREE.PlaneGeometry(100, 100);
            const floorMat = new THREE.MeshStandardMaterial({ map: floorTexture, roughness: 0.8 });
            const floor = new THREE.Mesh(floorGeo, floorMat);
            floor.rotation.x = -Math.PI / 2;
            floor.receiveShadow = true;
            scene.add(floor);

            // 벽 생성 (경기장 형태)
            createWalls();

            // 총기 3D 모델 생성 (카메라에 부착)
            createGun();

            // 초기 타겟 스폰
            for (let i = 0; i < 8; i++) spawnTarget();
        }

        function createWalls() {
            const wallMat = new THREE.MeshStandardMaterial({ color: 0x1f2937, roughness: 0.5 });
            const wallGeo = new THREE.BoxGeometry(100, 15, 2);

            const north = new THREE.Mesh(wallGeo, wallMat); north.position.set(0, 7.5, -50); scene.add(north);
            const south = new THREE.Mesh(wallGeo, wallMat); south.position.set(0, 7.5, 50); scene.add(south);
            const east = new THREE.Mesh(wallGeo, wallMat); east.rotation.y = Math.PI/2; east.position.set(50, 7.5, 0); scene.add(east);
            const west = new THREE.Mesh(wallGeo, wallMat); west.rotation.y = Math.PI/2; west.position.set(-50, 7.5, 0); scene.add(west);
        }

        // 메쉬 결합으로 만든 총기
        let gunGroup;
        function createGun() {
            gunGroup = new THREE.Group();

            const bodyGeo = new THREE.BoxGeometry(0.12, 0.15, 0.5);
            const bodyMat = new THREE.MeshStandardMaterial({ color: 0x333333, metalness: 0.8, roughness: 0.2 });
            const body = new THREE.Mesh(bodyGeo, bodyMat);
            gunGroup.add(body);

            const barrelGeo = new THREE.CylinderGeometry(0.03, 0.03, 0.4, 16);
            const barrelMat = new THREE.MeshStandardMaterial({ color: 0x111111, metalness: 0.9, roughness: 0.1 });
            const barrel = new THREE.Mesh(barrelGeo, barrelMat);
            barrel.rotation.x = Math.PI / 2;
            barrel.position.set(0, 0.04, -0.3);
            gunGroup.add(barrel);

            gunGroup.position.set(0.3, -0.25, -0.5);
            camera.add(gunGroup);
            scene.add(camera);
        }

        // --- 3. 타겟 및 파티클 관리 ---
        function spawnTarget() {
            const group = new THREE.Group();

            // 적 본체 (드론 형태)
            const geo = new THREE.SphereGeometry(1, 16, 16);
            const mat = new THREE.MeshStandardMaterial({ color: 0xff3355, roughness: 0.3, metalness: 0.7 });
            const body = new THREE.Mesh(geo, mat);
            group.add(body);

            // 빛나는 눈
            const eyeGeo = new THREE.SphereGeometry(0.3, 16, 16);
            const eyeMat = new THREE.MeshBasicMaterial({ color: 0x00ffff });
            const eye = new THREE.Mesh(eyeGeo, eyeMat);
            eye.position.set(0, 0, 0.9);
            group.add(eye);

            // 무작위 위치 설정
            const angle = Math.random() * Math.PI * 2;
            const dist = 15 + Math.random() * 25;
            group.position.set(Math.cos(angle) * dist, 1.5 + Math.random() * 3, Math.sin(angle) * dist);

            scene.add(group);
            targets.push(group);
            updateHUD();
        }

        // 파티클 폭발 효과
        function createExplosion(pos) {
            for (let i = 0; i < 15; i++) {
                const pGeo = new THREE.BoxGeometry(0.15, 0.15, 0.15);
                const pMat = new THREE.MeshBasicMaterial({ color: 0xffcc00 });
                const p = new THREE.Mesh(pGeo, pMat);
                p.position.copy(pos);
                
                p.userData = {
                    velocity: new THREE.Vector3(
                        (Math.random() - 0.5) * 8,
                        (Math.random() - 0.5) * 8,
                        (Math.random() - 0.5) * 8
                    ),
                    life: 1.0
                };
                scene.add(p);
                particles.push(p);
            }
        }

        // --- 4. 조작 및 사건 이벤트 ---
        const overlay = document.getElementById('overlay');
        const startBtn = document.getElementById('start-btn');

        startBtn.addEventListener('click', () => {
            initAudio();
            document.body.requestPointerLock();
        });

        document.addEventListener('pointerlockchange', () => {
            if (document.pointerLockElement === document.body) {
                isPlaying = true;
                overlay.style.display = 'none';
            } else {
                isPlaying = false;
                overlay.style.display = 'flex';
                document.getElementById('title-text').innerText = "PAUSED";
                document.getElementById('start-btn').innerText = "계속하기 (Resume)";
            }
        });

        // 마우스 시점 이동 (Yaw & Pitch)
        document.addEventListener('mousemove', (e) => {
            if (!isPlaying) return;
            yaw -= e.movementX * 0.002;
            pitch -= e.movementY * 0.002;

            // 시점 수직 한계 (상하 90도 제한)
            pitch = Math.max(-Math.PI / 2 + 0.05, Math.min(Math.PI / 2 - 0.05, pitch));
            camera.rotation.set(pitch, yaw, 0, 'YXZ');
        });

        // 이동 키 처리
        window.addEventListener('keydown', (e) => {
            if (e.code === 'KeyW') moveForward = true;
            if (e.code === 'KeyS') moveBackward = true;
            if (e.code === 'KeyA') moveLeft = true;
            if (e.code === 'KeyD') moveRight = true;
        });

        window.addEventListener('keyup', (e) => {
            if (e.code === 'KeyW') moveForward = false;
            if (e.code === 'KeyS') moveBackward = false;
            if (e.code === 'KeyA') moveLeft = false;
            if (e.code === 'KeyD') moveRight = false;
        });

        // 사격 기능 (Raycasting)
        window.addEventListener('mousedown', (e) => {
            if (!isPlaying || e.button !== 0) return;

            playGunshotSound();

            // 총기 반동 애니메이션
            gunGroup.position.z = -0.35;
            gunGroup.rotation.x = 0.1;

            // 광선 투사 (화면 중앙 조준점)
            const raycaster = new THREE.Raycaster();
            raycaster.setFromCamera(new THREE.Vector2(0, 0), camera);

            // 레이캐스팅을 위한 충돌체 배열 생성
            const hitObjects = [];
            targets.forEach(t => hitObjects.push(t.children[0]));

            const intersects = raycaster.intersectObjects(hitObjects);

            if (intersects.length > 0) {
                const hitMesh = intersects[0].object;
                const hitGroup = hitMesh.parent;

                playHitSound();
                createExplosion(hitGroup.position);

                // 적 제거 및 스폰
                scene.remove(hitGroup);
                const idx = targets.indexOf(hitGroup);
                if (idx > -1) targets.splice(idx, 1);

                score += 100;
                spawnTarget();
                updateHUD();
            }
        });

        function updateHUD() {
            document.getElementById('score-val').innerText = score;
            document.getElementById('hp-val').innerText = hp;
            document.getElementById('target-count').innerText = targets.length;
        }

        // --- 5. 게임 메인 루프 ---
        const clock = new THREE.Clock();

        function animate() {
            requestAnimationFrame(animate);

            const delta = clock.getDelta();

            if (isPlaying) {
                // 플레이어 이동 처리
                const speed = 10.0 * delta;
                const forward = new THREE.Vector3(0, 0, -1).applyAxisAngle(new THREE.Vector3(0, 1, 0), yaw);
                const side = new THREE.Vector3(1, 0, 0).applyAxisAngle(new THREE.Vector3(0, 1, 0), yaw);

                if (moveForward) camera.position.addScaledVector(forward, speed);
                if (moveBackward) camera.position.addScaledVector(forward, -speed);
                if (moveLeft) camera.position.addScaledVector(side, -speed);
                if (moveRight) camera.position.addScaledVector(side, speed);

                // 바깥 벽 밖으로 나가지 못하게 조절
                camera.position.x = Math.max(-48, Math.min(48, camera.position.x));
                camera.position.z = Math.max(-48, Math.min(48, camera.position.z));
                camera.position.y = 1.6; // 높이 고정

                // 총기 위치 복원 (반동 복귀)
                gunGroup.position.z += (-0.5 - gunGroup.position.z) * 0.15;
                gunGroup.rotation.x += (0 - gunGroup.rotation.x) * 0.15;

                // 타겟 업데이트 (플레이어 추적 & 위아래 둥둥 떠있기)
                const time = clock.getElapsedTime();
                targets.forEach(t => {
                    t.position.y = 1.5 + Math.sin(time * 2 + t.position.x) * 0.5;
                    t.lookAt(camera.position.x, t.position.y, camera.position.z);

                    // 천천히 플레이어에게 다가옴
                    const dir = new THREE.Vector3().subVectors(camera.position, t.position).normalize();
                    t.position.addScaledVector(dir, 1.2 * delta);

                    // 플레이어와 충돌 시 데미지
                    if (t.position.distanceTo(camera.position) < 1.8) {
                        hp -= 10;
                        updateHUD();
                        createExplosion(t.position);
                        t.position.set((Math.random() - 0.5) * 60, 2, (Math.random() - 0.5) * 60);

                        if (hp <= 0) {
                            document.exitPointerLock();
                            alert(`GAME OVER!\n최종 점수: ${score}`);
                            score = 0; hp = 100;
                            updateHUD();
                        }
                    }
                });

                // 파티클 애니메이션
                for (let i = particles.length - 1; i >= 0; i--) {
                    const p = particles[i];
                    p.position.addScaledVector(p.userData.velocity, delta);
                    p.userData.life -= delta * 2;
                    p.scale.multiplyScalar(0.95);

                    if (p.userData.life <= 0) {
                        scene.remove(p);
                        particles.splice(i, 1);
                    }
                }
            }

            renderer.render(scene, camera);
        }

        // 창 크기 변경 대응
        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });

        // 게임 시작
        initScene();
        animate();
    </script>
</body>
</html>
